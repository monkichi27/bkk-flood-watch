# เขตที่ต้องการเฝ้าระวัง (คั่นด้วย ,) — ใช้ชื่อเขตตามข้อมูล กทม.
DISTRICTS=ประเวศ,สวนหลวง,บางกะปิ,ลาดพร้าว
POLL_MINUTES=5
PORT=3000

# เกณฑ์ "น้ำขึ้นเร็ว": ขึ้น >= RISE_THRESHOLD_M เมตร ภายใน RISE_WINDOW_MINUTES นาที
RISE_THRESHOLD_M=0.10
RISE_WINDOW_MINUTES=60

# สีของแต่ละจุดดูจากระยะผิวน้ำถึงตลิ่ง (เมตร): น้อยกว่า DANGER = แดง, น้อยกว่า WATCH = เหลือง
DANGER_FREEBOARD_M=0.3
WATCH_FREEBOARD_M=0.6
ALERT_COOLDOWN_MINUTES=120
STALE_MINUTES=60

# กล้อง CCTV จราจร กทม. ที่อยู่ห่างจุดวัดไม่เกินกี่ กม. (0 = ปิด)
CCTV_RADIUS_KM=1.5

# ---- ช่องทางแจ้งเตือน (ใส่เฉพาะที่ใช้) ----
# ntfy: ติดตั้งแอป ntfy บนมือถือ แล้ว subscribe หัวข้อเดียวกัน (ตั้งชื่อยาว ๆ เดายาก)
NTFY_TOPIC=
# Telegram: สร้างบอทกับ @BotFather แล้วหา chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# LINE Messaging API (LINE Notify ปิดบริการแล้ว) — ใช้ Channel access token + userId/groupId
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
# Discord webhook
DISCORD_WEBHOOK_URL=
